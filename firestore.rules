rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthed() && request.auth.uid == userId;
    }

    /** JWT custom claim (Admin SDK only). */
    function hasAdminCustomClaim() {
      return isAuthed() && request.auth.token.admin == true;
    }

    function hasAdminRoleFirestore() {
      return isAuthed() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function hasAdminRole() {
      return hasAdminCustomClaim() || hasAdminRoleFirestore();
    }

    /** Legacy admin email — keep until all admins use claims / role doc. */
    function isLegacyAdminEmail() {
      return isAuthed() && request.auth.token.email == "haritha.mh77@gmail.com";
    }

    function isAdmin() {
      return hasAdminRole() || isLegacyAdminEmail();
    }

    /** Admin + rider must not mutate payment / Stripe fields (webhook + proof flows only). */
    function orderPaymentStripeCoreUnchanged() {
      return request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.payment_status == resource.data.payment_status
        && request.resource.data.paidAt == resource.data.paidAt
        && request.resource.data.paymentIntentId == resource.data.paymentIntentId
        && request.resource.data.stripeCheckoutSessionId == resource.data.stripeCheckoutSessionId;
    }

    /** Clients must never mutate canonical lifecycle status directly. */
    function orderStatusUnchanged() {
      return request.resource.data.status == resource.data.status;
    }

    function hasRiderRoleFirestore() {
      return isAuthed()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "rider";
    }

    function riderOwnsAssignedOrder() {
      return hasRiderRoleFirestore()
        && resource.data.riderId == request.auth.uid;
    }

    /** Hosted Stripe / card: owner may upload proof only — never client-set paid. */
    function isStripeLikeOrder() {
      return resource.data.paymentMethod == 'STRIPE'
        || resource.data.paymentMethod == 'CARD'
        || resource.data.payment_method == 'stripe'
        || resource.data.payment_method == 'card'
        || resource.data.status == 'pending_payment';
    }

    function orderCustomerStripeProofOnlyUpdate() {
      return isStripeLikeOrder()
        && isAuthed()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'updatedAt',
            'payment_screenshot',
            'paymentProofSubmitted',
            'customerMarkedPaidAt',
            'qrCustomerClaimedAt',
          ]);
    }

    /** COD / QR / non-hosted: owner may claim paid + proof fields only (no lifecycle). */
    function orderCustomerNonStripePaymentOrProofUpdate() {
      return !isStripeLikeOrder()
        && isAuthed()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'updatedAt',
            'paymentStatus',
            'payment_screenshot',
            'paymentProofSubmitted',
            'customerMarkedPaidAt',
            'qrCustomerClaimedAt',
          ]);
    }

    /** Assigned rider: delivery-related fields only; payment immutable. */
    function riderOrderFulfillmentUpdate() {
      return riderOwnsAssignedOrder()
        && orderStatusUnchanged()
        && orderPaymentStripeCoreUnchanged()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.items == resource.data.items
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'riderId',
            'customerSnapshot',
            'updatedAt',
            'timestamps',
            'rider',
            'chatEnabled',
          ]);
    }

    /** Admin: fulfilment anytime without mutating payment; or COD/QR payment flags only (not Stripe-like). */
    function orderAdminUpdateAllowed() {
      return isAdmin() && (
        orderStatusUnchanged()
        && orderPaymentStripeCoreUnchanged()
        || (
          !isStripeLikeOrder()
          && orderStatusUnchanged()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['paymentStatus', 'updatedAt'])
        )
      );
    }

    function orderRef(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId));
    }

    function isOrderParticipant(orderId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/orders/$(orderId))
        && (
          orderRef(orderId).data.userId == request.auth.uid
          || orderRef(orderId).data.riderId == request.auth.uid
          || isAdmin()
        );
    }

    // --- Public catalog (read-only for clients) ---
    match /categories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

    match /checkout_lease/{uid} {
      allow read: if isAuthed() && request.auth.uid == uid;
      allow write: if false;
    }

    // --- Orders: creates via Cloud Functions / Admin SDK only ---
    match /orders/{orderId} {
      allow create: if false;
      allow delete: if false;

      allow read: if isAuthed()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
          || resource.data.riderId == request.auth.uid
        );

      allow update: if orderStatusUnchanged()
        && (
          orderAdminUpdateAllowed()
        || orderCustomerStripeProofOnlyUpdate()
        || orderCustomerNonStripePaymentOrProofUpdate()
        || riderOrderFulfillmentUpdate()
        );

      match /messages/{messageId} {
        allow read, create, update: if isOrderParticipant(orderId);
        allow delete: if isAdmin();
      }
    }

    match /riders/{riderId} {
      allow read, write: if isAuthed()
        && (isAdmin() || request.auth.uid == riderId);
    }

    match /chats/{orderId} {
      allow read, write: if isOrderParticipant(orderId);
      match /messages/{messageId} {
        allow read, write: if isOrderParticipant(orderId);
      }
    }

    // Mirror of orders for tracking — client read-only; writes via Admin SDK / Functions only.
    match /public_tracking/{orderId} {
      allow read: if true;
      allow write: if false;
    }

    match /admin_push_tokens/{tokenDoc} {
      allow read: if false;
      allow write: if isAdmin();
    }

    match /customer_push_tokens/{userId} {
      allow read: if false;
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /support_chats/{conversationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
      match /messages/{messageId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
